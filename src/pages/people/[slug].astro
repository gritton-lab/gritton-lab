---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

type PersonIdentity = {
  firstName: string;
  lastName: string;
  bylineInitials: Set<string>;
};

export const getStaticPaths = (async () => {
  // Keep matching helpers inside getStaticPaths: Astro executes this exported
  // function in its own prerendering scope.
  const normalizeNamePart = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z]/gi, '')
      .toLocaleLowerCase();

  const getPersonIdentity = (person: CollectionEntry<'team'>): PersonIdentity => {
    const publicName = person.data.name.split(',')[0].trim();
    const words = publicName
      .replace(/\./g, '')
      .split(/\s+/)
      .map(normalizeNamePart)
      .filter(Boolean);
    const firstName = words[0] ?? '';
    const lastName = words.at(-1) ?? '';
    const bylineInitials = new Set<string>();

    if (firstName) bylineInitials.add(firstName.charAt(0));

    // Some profiles use a preferred first name while their institutional email
    // preserves a publication name (for example, zhiliqu -> Qu Z). Only derive
    // that initial when the full surname is visibly present in the email stem.
    const emailStem = person.data.email
      ?.split('@')[0]
      .replace(/\d+$/g, '')
      .replace(/[^a-z]/gi, '')
      .toLocaleLowerCase();
    if (emailStem && lastName && emailStem.endsWith(lastName)) {
      const emailGivenName = emailStem.slice(0, -lastName.length);
      if (emailGivenName) bylineInitials.add(emailGivenName.charAt(0));
    }

    return { firstName, lastName, bylineInitials };
  };

  const publicationMatches = (
    publication: CollectionEntry<'publications'>,
    identity: PersonIdentity,
  ) => {
    if (!identity.lastName) return false;

    return publication.data.authors.split(',').some((rawByline) => {
      const byline = rawByline.replace(/\*/g, '').trim().split(/\s+/);
      const surname = normalizeNamePart(byline[0] ?? '');
      const initial = normalizeNamePart(byline[1] ?? '').charAt(0);

      return surname === identity.lastName && Boolean(initial) && identity.bylineInitials.has(initial);
    });
  };

  const normalizedWords = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .toLocaleLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const hasWholeNamePart = (text: string, namePart: string) => {
    if (!namePart) return false;
    return ` ${normalizedWords(text)} `.includes(` ${namePart} `);
  };

  const [people, publications, news] = await Promise.all([
    getCollection('team'),
    getCollection('publications'),
    getCollection('news', ({ data }) => !data.draft),
  ]);

  const identities = new Map(people.map((person) => [person.id, getPersonIdentity(person)]));
  const firstNameFrequency = people.reduce<Record<string, number>>((counts, person) => {
    const firstName = identities.get(person.id)?.firstName;
    if (firstName) counts[firstName] = (counts[firstName] ?? 0) + 1;
    return counts;
  }, {});

  return people
    .filter((person) => person.data.group !== 'alumni')
    .sort((a, b) => a.data.order - b.data.order)
    .map((person) => {
      const identity = identities.get(person.id)!;
      // Skip undergraduates to avoid matching unrelated authors by surname and initial.
      const publicationMatchesForPerson = (person.data.group === 'undergrad' ? [] : publications)
        .filter((publication) => publicationMatches(publication, identity))
        .sort((a, b) => {
          if (b.data.year !== a.data.year) return b.data.year - a.data.year;
          return a.data.order - b.data.order;
        });

      const relatedNews = news
        .filter((post) => {
          const searchable = [post.data.title, post.data.summary, post.data.imageAlt, post.body]
            .filter(Boolean)
            .join(' ');
          const lastNameMatch = hasWholeNamePart(searchable, identity.lastName);
          const uniqueFirstNameMatch =
            (firstNameFrequency[identity.firstName] ?? 0) === 1 &&
            hasWholeNamePart(searchable, identity.firstName);
          return lastNameMatch || uniqueFirstNameMatch;
        })
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
        .slice(0, 4);

      return {
        params: { slug: person.id },
        props: {
          person,
          relatedPublications: publicationMatchesForPerson.slice(0, 5),
          relatedPublicationCount: publicationMatchesForPerson.length,
          relatedNews,
        },
      };
    });
}) satisfies GetStaticPaths;

interface Props {
  person: CollectionEntry<'team'>;
  relatedPublications: CollectionEntry<'publications'>[];
  relatedPublicationCount: number;
  relatedNews: CollectionEntry<'news'>[];
}

const { person, relatedPublications, relatedPublicationCount, relatedNews } = Astro.props;
const { Content } = await render(person);
const d = person.data;
const hasBio = Boolean(person.body?.trim());

const groupLabels: Record<typeof d.group, string> = {
  pi: 'Lab leadership',
  grad: 'Graduate researcher',
  undergrad: 'Undergraduate researcher',
  staff: 'Lab staff',
  alumni: 'Lab alumni',
};

const contactRows = [
  d.email ? { label: 'Email', value: d.email, href: `mailto:${d.email}` } : null,
  d.phone ? { label: 'Phone', value: d.phone, href: `tel:${d.phone.replace(/[^\d+]/g, '')}` } : null,
  d.lab ? { label: 'Lab', value: d.lab } : null,
  d.office ? { label: 'Office', value: d.office } : null,
].filter(Boolean) as { label: string; value: string; href?: string }[];

const hasAside =
  Boolean(d.photo) || contactRows.length > 0 || d.education.length > 0 || d.links.length > 0;

const truncatedPubs = relatedPublicationCount > relatedPublications.length;

// A story known only to a month (no specific day) drops the day here too.
const formatDate = (date: Date, precision: 'day' | 'month' = 'day') =>
  precision === 'month'
    ? date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={d.name} description={d.program ?? d.role}>
  <section class="profile">
    <div class="container-page">
      <a class="text-link profile__back" href="/people">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        All people
      </a>

      <div class="profile__layout">
        <header class="profile__head">
          <p class="eyebrow">{groupLabels[d.group]}</p>
          <h1 class="profile__name">{d.name}</h1>
          <p class="profile__role">{d.role}</p>
          {d.program && <p class="profile__program">{d.program}</p>}
        </header>

        <div class:list={['profile__cols', !hasAside && 'profile__cols--solo']}>
        {
          hasAside && (
            <aside class="profile__aside">
              {d.photo ? (
                <div class="profile__photo">
                  <img src={d.photo} alt={d.name} width="480" height="600" loading="eager" />
                </div>
              ) : (
                <div class="profile__photo profile__photo--empty" aria-hidden="true">
                  <span>Gritton Lab</span>
                </div>
              )}

              {contactRows.length > 0 && (
                <dl class="profile__facts">
                  {contactRows.map((row) => (
                    <div class="profile__fact">
                      <dt>{row.label}</dt>
                      <dd>
                        {row.href ? (
                          <a class="link-underline" href={row.href}>
                            {row.value}
                          </a>
                        ) : (
                          row.value
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              {d.education.length > 0 && (
                <div class="profile__facts">
                  <p class="profile__kicker">Appointments &amp; education</p>
                  <ul class="profile__edu">
                    {d.education.map((entry) => (
                      <li>{entry}</li>
                    ))}
                  </ul>
                </div>
              )}

              {d.links.length > 0 && (
                <div class="profile__links">
                  {d.links.map((link) => (
                    <a class="button" href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </a>
                  ))}
                </div>
              )}
            </aside>
          )
        }

        <div class="profile__main">
          {
            hasBio && (
              <section class="profile__block">
                <p class="profile__kicker profile__kicker--lead">About</p>
                <div class="profile__bio">
                  <Content />
                </div>
              </section>
            )
          }

          {
            relatedPublications.length > 0 && (
              <section class="profile__block">
                <div class="profile__block-head">
                  <p class="profile__kicker">
                    Selected work{truncatedPubs && ` · ${relatedPublications.length} of ${relatedPublicationCount}`}
                  </p>
                  <a class="text-link" href="/publications">
                    Full archive
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>

                <ol class="profile__pubs">
                  {relatedPublications.map((publication) => (
                    <li class="profile__pub">
                      <p class="profile__pub-authors">{publication.data.authors}</p>
                      <h2 class="profile__pub-title">
                        {publication.data.url ? (
                          <a
                            class="link-underline"
                            href={publication.data.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {publication.data.title}
                          </a>
                        ) : (
                          publication.data.title
                        )}
                      </h2>
                      <p class="profile__pub-meta">
                        {publication.data.journal} · {publication.data.year}
                        {publication.data.note && ` · ${publication.data.note}`}
                      </p>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            relatedNews.length > 0 && (
              <section class="profile__block">
                <div class="profile__block-head">
                  <p class="profile__kicker">In the news</p>
                  <a class="text-link" href="/news">
                    All news
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>

                <ul class="profile__news">
                  {relatedNews.map((post) => (
                    <li class="profile__news-item">
                      <a href={`/news/${post.id}`}>
                        <span class="profile__news-date">{formatDate(post.data.date, post.data.datePrecision)}</span>
                        <span class="profile__news-title">{post.data.title}</span>
                        <svg class="profile__news-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .profile {
    background: var(--paper-bright);
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 7vw, 5.5rem);
  }

  .profile__back { margin-bottom: var(--space-lg); }

  /* -------------------------------------------------------------- Layout */

  .profile__head {
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--line);
  }

  .profile__head .eyebrow { margin-bottom: 0.75rem; }

  .profile__cols {
    display: grid;
    gap: var(--space-lg);
  }

  .profile__name {
    margin: 0;
    font-size: clamp(1.85rem, 3vw, 2.55rem);
    line-height: 1.06;
  }

  .profile__role {
    margin-top: 0.65rem;
    color: var(--signal-dark);
    font-size: 1rem;
    font-weight: 600;
  }

  .profile__program {
    margin-top: 0.3rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* -------------------------------------------------------------- Aside */

  .profile__aside {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  .profile__photo {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .profile__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
  }

  .profile__photo--empty {
    display: grid;
    aspect-ratio: 4 / 5;
    place-items: center;
    background: repeating-linear-gradient(135deg, var(--paper) 0 10px, var(--paper-deep) 10px 20px);
  }

  .profile__photo--empty span {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .profile__kicker {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .profile__facts { display: grid; }

  .profile__facts + .profile__facts { margin-top: var(--space-xs); }

  .profile__fact {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--line);
  }

  .profile__fact:first-child { border-top: 0; padding-top: 0; }

  .profile__fact dt {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .profile__fact dd {
    color: var(--ink);
    font-size: 0.88rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .profile__facts .profile__kicker { margin-bottom: 0.6rem; }

  .profile__edu {
    display: grid;
    gap: 0.45rem;
  }

  .profile__edu li {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .profile__links {
    display: grid;
    gap: var(--space-sm);
  }

  .profile__links .button {
    width: 100%;
    min-height: 2.6rem;
  }

  /* -------------------------------------------------------------- Main */

  .profile__main { min-width: 0; }

  .profile__block { margin-top: var(--space-lg); }

  .profile__main > .profile__block:first-child { margin-top: 0; }

  .profile__block + .profile__block {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .profile__pub:last-child,
  .profile__news-item:last-child { border-bottom: 0; }

  .profile__block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin-bottom: var(--space-md);
  }

  .profile__kicker--lead { margin-bottom: var(--space-sm); }

  .profile__bio {
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .profile__bio :global(p) { margin-block: 0.9em; }
  .profile__bio :global(> :first-child) { margin-top: 0; }
  .profile__bio :global(> :last-child) { margin-bottom: 0; }

  .profile__bio :global(a) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  /* Publications */

  .profile__pubs { border-top: 1px solid var(--line); }

  .profile__pub {
    display: grid;
    gap: 0.3rem;
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--line);
  }

  .profile__pub-authors {
    color: var(--ink-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .profile__pub-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .profile__pub-meta {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.5;
  }

  /* News */

  .profile__news { border-top: 1px solid var(--line); }

  .profile__news-item { border-bottom: 1px solid var(--line); }

  .profile__news-item a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.15rem 1rem;
    padding-block: 0.8rem;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .profile__news-item a:hover { color: var(--signal); }

  .profile__news-date {
    grid-column: 1 / -1;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .profile__news-title {
    font-family: var(--font-display);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .profile__news-arrow {
    flex: none;
    color: var(--signal-dark);
    transition: transform 200ms var(--ease-spring);
  }

  .profile__news-item a:hover .profile__news-arrow { transform: translateX(3px); }

  /* -------------------------------------------------------------- Wide */

  @media (min-width: 820px) {
    .profile__cols {
      grid-template-columns: minmax(0, 16.5rem) minmax(0, 1fr);
      column-gap: clamp(2.25rem, 5vw, 4rem);
      align-items: start;
    }

    .profile__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-md));
    }

    .profile__main { max-width: 46rem; }

    .profile__cols--solo { grid-template-columns: minmax(0, 1fr); }
    .profile__cols--solo .profile__main { max-width: 52rem; }
  }
</style>
