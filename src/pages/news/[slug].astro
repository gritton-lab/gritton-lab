---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const { title, date, datePrecision, summary, image, imageAlt, video } = post.data;
const { Content } = await render(post);

const more = (await getCollection('news', ({ data }) => !data.draft))
  .filter((item) => item.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// A story known only to a month (no specific day) drops the day here too.
const formatDate = (value: Date, precision: 'day' | 'month' = 'day') =>
  precision === 'month'
    ? value.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
    : value.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const formatShort = (value: Date, precision: 'day' | 'month' = 'day') =>
  precision === 'month'
    ? value.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : value.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={title} description={summary}>
  <section class:list={['story', image && 'has-figure']}>
    <div class="container-page">
      <a class="text-link story__back" href="/news">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        All news
      </a>

      <div class="story__body">
        <div class="story__head">
          <p class="eyebrow">
            <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, datePrecision)}</time>
          </p>
          <h1 class="story__title">{title}</h1>
        </div>

        {
          image && (
            <figure class="story__figure">
              <img src={image} alt="" />
              {imageAlt && <figcaption class="meta">{imageAlt}</figcaption>}
            </figure>
          )
        }

        <div class="story__main">
          {
            video && (
              <div class="story__video">
                <VideoEmbed url={video} title={title} />
              </div>
            )
          }

          <article class="prose-lab story__prose">
            <Content />
          </article>
        </div>
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="page-section">
        <div class="container-page">
          <SectionHeading
            eyebrow="More news"
            title="Other stories from the lab."
            actionHref="/news"
            actionLabel="All news"
          />

          <div class="section-body card-grid card-grid--3">
            {more.map((item) => (
              <Card
                href={`/news/${item.id}`}
                eyebrow={formatShort(item.data.date, item.data.datePrecision)}
                title={item.data.title}
                summary={item.data.summary}
                image={item.data.image}
                imageAlt={item.data.imageAlt}
                category={item.data.category}
                footLabel="Read story"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    eyebrow="The research"
    title="What the lab is working on."
    body="The projects and publications behind the news."
    links={[
      { label: 'Research projects', href: '/projects', primary: true },
      { label: 'Publications', href: '/publications' },
    ]}
  />
</Base>

<style>

  .story { background: var(--paper-bright); }

  .story .container-page {
    padding-block: clamp(1.5rem, 2.6vw, 2.25rem) clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .story__back { margin-bottom: var(--space-lg); }
  .story .eyebrow { margin-bottom: 0.9rem; }

  .story__title {
    max-width: 20ch;
    margin: 0;
  }

  .story__body { display: grid; gap: var(--space-lg); }

  @media (min-width: 900px) {
    /* Absolute positioning prevents the photo from stretching headline and story rows. */
    .story.has-figure .story__body {
      position: relative;
      display: block;
      min-height: 26rem;
      padding-right: calc(24rem + var(--space-block));
    }

    .story.has-figure .story__figure {
      position: absolute;
      top: 0;
      right: 0;
      width: 24rem;
    }

    .story.has-figure .story__main { margin-top: var(--space-lg); }
  }

  .story__video { max-width: 46rem; margin-bottom: var(--space-lg); }

  .story__figure {
    border: 1px solid var(--line-strong);
    background: var(--paper-bright);
    padding: 0.5rem;
  }

  .story__figure img {
    display: block;
    width: 100%;
    max-height: 22rem;
    /* Crops rather than squashes when a tall photo meets the cap. */
    object-fit: cover;
  }

  .story__figure figcaption {
    margin-top: 0.7rem;
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }

  .story__prose {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    column-gap: var(--space-md);
  }

  .story__prose > :global(*) { grid-column: 1 / -1; }

  @media (min-width: 34rem) {
    .story__prose { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    /* Half the gutter each side, so the row gap matches the column gap. */
    .story__prose > :global(p:has(> img:only-child)) {
      grid-column: auto;
      margin-block: calc(var(--space-md) / 2);
    }
  }

  .story__prose :global(p:has(> img:only-child) > img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 30%;
    margin: 0;
  }

</style>
