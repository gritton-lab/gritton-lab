---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import CtaBand from '../../components/CtaBand.astro';
import NewsReel from '../../components/NewsReel.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'news'>>;
}

const { page } = Astro.props;

const pageHref = (number: number) => (number === 1 ? '/news' : `/news/${number}`);

// A story known only to a month (no specific day) drops the day here too.
const formatDate = (date: Date, precision: 'day' | 'month' = 'day') =>
  precision === 'month'
    ? date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

/* Per-story object-position values keep faces above the reel caption. */
const FACES: Record<string, string> = {
  'martin-presents-work-on-spatial-attention-at-cns': '51%',
  'meeting-temple-grandin': '21%',
  'oliver-presents-at-bioe-graduate-research-symposium': '40%',
  'oliver-presents-at-ear-day-2024': '53%',
  'undergrads-present-posters-at-2024-isur-and-urs-expos': '26%',
};

const reelItems = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    href: `/news/${post.id}`,
    title: post.data.title,
    summary: post.data.summary,
    date: formatDate(post.data.date, post.data.datePrecision),
    // Month and day on the axis, the year stacked under it, as on a chart.
    // A month-only story just shows the month, same as everywhere else it's dated.
    stamp:
      post.data.datePrecision === 'month'
        ? post.data.date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })
        : post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }),
    year: String(post.data.date.getUTCFullYear()),
    image: post.data.image,
    imageAlt: post.data.imageAlt,
    focus: FACES[post.id] ?? '42%',
    category: post.data.category,
  }));
---

<Base title="News" description="Awards, presentations, grants, and visitors from the Gritton Lab.">
  <PageHero
    eyebrow="News"
    title="From the lab bench."
    lede="Awards, conference presentations, new grants, and the people passing through the lab."
  >
    <NewsReel items={reelItems} />
  </PageHero>

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Latest first"
        title="Lab news and field notes."
        intro="The most recent items appear first. Older entries continue on the following pages."
      />

      <div class="section-body card-grid card-grid--3">
        {
          page.data.map((post) => (
            <Card
              href={`/news/${post.id}`}
              eyebrow={formatDate(post.data.date, post.data.datePrecision)}
              title={post.data.title}
              summary={post.data.summary}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
              category={post.data.category}
              footLabel="Read story"
            />
          ))
        }
      </div>

      {
        page.lastPage > 1 && (
          <nav class="pagination" aria-label="News pages">
            {page.url.prev ? (
              <a class="button" href={page.url.prev}>Newer</a>
            ) : (
              <span class="button is-disabled" aria-disabled="true">Newer</span>
            )}

            <p class="meta">Page {page.currentPage} of {page.lastPage}</p>

            {page.url.next ? (
              <a class="button" href={page.url.next}>Older</a>
            ) : (
              <span class="button is-disabled" aria-disabled="true">Older</span>
            )}
          </nav>
        )
      }
    </div>
  </section>

  <CtaBand
    eyebrow="Elsewhere"
    title="Follow the research itself."
    body="The projects behind these stories, and the papers they turned into."
    links={[
      { label: 'Research projects', href: '/projects', primary: true },
      { label: 'Publications', href: '/publications' },
    ]}
  />
</Base>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-block);
  }

  .button.is-disabled {
    border-color: var(--line);
    color: var(--ink-muted);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .button.is-disabled:hover {
    background: transparent;
    color: var(--ink-muted);
  }
</style>
