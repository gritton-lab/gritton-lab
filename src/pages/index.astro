---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CardCarousel from '../components/CardCarousel.astro';
import NeuralScene from '../components/NeuralScene.astro';
import CircuitQuestion from '../components/CircuitQuestion.astro';
import PublicationCarousel from '../components/PublicationCarousel.astro';
import FigureBand from '../components/FigureBand.astro';
import { homePhotos } from '../data/photoBands';
import home from '../data/home.json';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);

const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const latestNews = news.slice(0, 6);

/* Split the shared intro into lead and supporting paragraphs. */
const introBreak = home.intro.indexOf('However');
const introLead = introBreak > 0 ? home.intro.slice(0, introBreak).trim() : home.intro;
const introDetail = introBreak > 0 ? home.intro.slice(introBreak).trim() : '';

// A story known only to a month (no specific day) drops the day here too.
const formatDate = (date: Date, precision: 'day' | 'month' = 'day') =>
  precision === 'month'
    ? date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base description={home.heroSubtext}>
  <section class="hero" aria-label="Gritton Lab">
    <NeuralScene />

    <div class="container-page hero__content">
      <p class="hero__eyebrow">Neural circuits in focus</p>
      <h1 class="hero__title">How does a brain <span>decide what matters?</span></h1>
      <p class="hero__subtext">{home.heroSubtext}</p>

      <div class="actions hero__actions">
        <a class="button button--primary" href="/projects">
          Explore our research
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="button button--light" href="/lab-positions">
          Join the lab
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Our premise"
        title="Attention, learning, and memory begin as coordinated activity."
      />

      <div class="section-body premise">
        <div class="premise__copy">
          <p class="lede">{introLead}</p>
          {introDetail && <p class="lede">{introDetail}</p>}
          <a class="text-link premise__action" href="/about">
            About the lab
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        <div class="premise__interests">
          <p class="meta premise__interests-label">{home.researchInterestsHeading}</p>
          <ul class="premise__list">
            {home.researchInterests.map((interest) => <li>{interest}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CircuitQuestion />

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Research"
        title="What we study."
        intro="Five active projects spanning oscillations, auditory attention, autism models, circuit homeostasis, and environmental risk."
        actionHref="/projects"
        actionLabel="All projects"
      />

      <CardCarousel label="Research projects">
        {
          projects.map((project) => (
            <Card
              href={`/projects/${project.id}`}
              eyebrow="Research project"
              title={project.data.title}
              summary={project.data.summary}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              media="figure"
              footLabel="View project"
            />
          ))
        }
      </CardCarousel>
    </div>
  </section>

  <FigureBand slides={homePhotos} />

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Publications"
        title="Recent work in the record."
        actionHref="/publications"
        actionLabel="All publications"
      />

      <PublicationCarousel>
        {
          publications.map((publication, index) => (
            <li class="ruled-row ruled-row--indexed">
              <span class="ruled-row__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="ruled-row__body">
                <p class="note">{publication.data.authors}</p>
                <h3 class="ruled-row__title">{publication.data.title}</h3>
                <p class="ruled-row__meta">
                  {publication.data.journal} · {publication.data.year}
                </p>
              </div>
              {publication.data.url && (
                <a
                  class="text-link ruled-row__action"
                  href={publication.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  DOI
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              )}
            </li>
          ))
        }
      </PublicationCarousel>
    </div>
  </section>

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="News"
        title="Latest from the lab."
        actionHref="/news"
        actionLabel="All news"
      />

      <CardCarousel label="Latest lab news" interval={9000}>
        {
          latestNews.map((story) => (
            <Card
              href={`/news/${story.id}`}
              eyebrow={formatDate(story.data.date, story.data.datePrecision)}
              title={story.data.title}
              summary={story.data.summary}
              image={story.data.image}
              imageAlt={story.data.imageAlt}
              imageFit={story.data.imageFit}
              imageFocus={story.data.imageFocus}
              category={story.data.category}
              footLabel="Read story"
            />
          ))
        }
      </CardCarousel>
    </div>
  </section>

</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    align-content: center;
    overflow: hidden;
    background: var(--panel-bg);
    color: #fff;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 6rem 9rem;
    pointer-events: none;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.4rem;
    color: var(--panel-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero__eyebrow::before {
    width: 2rem;
    height: 1px;
    flex: none;
    background: currentColor;
    content: '';
  }

  .hero__title {
    max-width: 12ch;
    color: var(--panel-text);
    font-size: clamp(3.2rem, 5.4vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.02;
  }

  .hero__title span { color: var(--panel-accent); }

  .hero__subtext {
    max-width: 43ch;
    margin-top: 1.5rem;
    color: var(--panel-muted);
    font-size: clamp(0.95rem, 1.1vw, 1.08rem);
    line-height: 1.8;
  }

  .hero__actions { margin-top: 2rem; }
  .hero__actions a { pointer-events: auto; }

  .hero__actions .button { min-height: 3rem; font-weight: 600; background: var(--panel-text); border-color: var(--panel-text); color: var(--panel-bg); }
  .hero__actions .button:hover { background: var(--art-line); border-color: var(--art-line); color: var(--panel-bg); }

  @media (max-width: 700px) {
    .hero { min-height: max(100svh, 52rem); align-content: end; }
    .hero__content { padding-block: 15rem 6rem; }
    .hero__title { max-width: 13ch; font-size: clamp(2.8rem, 9vw, 3.8rem); }
    .hero__subtext { max-width: 38ch; font-size: 0.92rem; }
    .hero__eyebrow { margin-bottom: 1rem; }
    .hero__actions { gap: 0.65rem; }
    .hero__actions .button { padding-inline: 0.9rem; font-size: 0.85rem; }
  }

  /* --------------------------------------------------------------- Premise */

  .premise {
    display: grid;
    gap: var(--space-block);
  }

  .premise__copy > * + * { margin-top: 1.1rem; }
  .premise__action { margin-top: 1.4rem; }

  .premise__interests-label { margin-bottom: 0.5rem; }

  .premise__list { display: grid; }

  .premise__list li {
    border-bottom: 1px solid var(--line);
    padding-block: 0.7rem;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .premise { grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr); }
  }
</style>
