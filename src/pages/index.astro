---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import StatementBand from '../components/StatementBand.astro';
import FigureBand from '../components/FigureBand.astro';
import home from '../data/home.json';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);

const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featuredProjects = projects.slice(0, 3);
const recentPublications = publications.slice(0, 5);
const latestNews = news.slice(0, 3);

/* Split the shared intro into lead and supporting paragraphs. */
const introBreak = home.intro.indexOf('However');
const introLead = introBreak > 0 ? home.intro.slice(0, introBreak).trim() : home.intro;
const introDetail = introBreak > 0 ? home.intro.slice(introBreak).trim() : '';

// A story known only to a month (no specific day) drops the day here too.
const formatDate = (date: Date, precision: 'day' | 'month' = 'day') =>
  precision === 'month'
    ? date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base description={home.heroSubtext}>
  <section class="hero" aria-label="Gritton Lab">
    <img
      class="hero__image"
      src="/images/uploads/bioe-symposium.jpeg"
      alt="Gritton Lab researchers at the Bioengineering Graduate Research Symposium"
      width="1400"
      height="1050"
      fetchpriority="high"
    />
    <div class="hero__wash" aria-hidden="true"></div>

    <div class="container-page hero__content">
      <p class="hero__eyebrow">Neural circuits in focus</p>
      <h1 class="hero__title">How does a brain decide what matters?</h1>
      <p class="hero__subtext">{home.heroSubtext}</p>

      <div class="actions hero__actions">
        <a class="button button--primary" href="/projects">
          Explore our research
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="button button--light" href="/lab-positions">
          Join the lab
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Our premise"
        title="Attention, learning, and memory begin as coordinated activity."
      />

      <div class="section-body premise">
        <div class="premise__copy">
          <p class="lede">{introLead}</p>
          {introDetail && <p class="lede">{introDetail}</p>}
          <a class="text-link premise__action" href="/about">
            About the lab
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        <div class="premise__interests">
          <p class="meta premise__interests-label">{home.researchInterestsHeading}</p>
          <ul class="premise__list">
            {home.researchInterests.map((interest) => <li>{interest}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <StatementBand
    eyebrow="The question"
    statement="How do thousands of cells act in unison at exactly the right moment?"
  />

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Research"
        title="What we study."
        intro="Five active projects spanning oscillations, auditory attention, autism models, circuit homeostasis, and environmental risk."
        actionHref="/projects"
        actionLabel="All projects"
      />

      <div class="section-body card-grid card-grid--3">
        {
          featuredProjects.map((project) => (
            <Card
              href={`/projects/${project.id}`}
              eyebrow="Research project"
              title={project.data.title}
              summary={project.data.summary}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              media="figure"
              footLabel="View project"
            />
          ))
        }
      </div>
    </div>
  </section>

  <FigureBand
    image="/images/uploads/martin-cns.jpeg"
    alt="Martin presenting lab research at the Cognitive Neuroscience Society meeting"
    label="Cognitive Neuroscience Society"
    caption="Presenting work on cortical circuit dynamics in spatially directed attention."
    focus="60% center"
  />

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="Publications"
        title="Recent work in the record."
        actionHref="/publications"
        actionLabel="All publications"
      />

      <ol class="section-body ruled-list">
        {
          recentPublications.map((publication, index) => (
            <li class="ruled-row ruled-row--indexed">
              <span class="ruled-row__index">{String(index + 1).padStart(2, '0')}</span>
              <div class="ruled-row__body">
                <p class="note">{publication.data.authors}</p>
                <h3 class="ruled-row__title">{publication.data.title}</h3>
                <p class="ruled-row__meta">
                  {publication.data.journal} · {publication.data.year}
                </p>
              </div>
              {publication.data.url && (
                <a
                  class="text-link ruled-row__action"
                  href={publication.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  DOI
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="page-section">
    <div class="container-page">
      <SectionHeading
        eyebrow="News"
        title="Latest from the lab."
        actionHref="/news"
        actionLabel="All news"
      />

      <div class="section-body card-grid card-grid--3">
        {
          latestNews.map((story) => (
            <Card
              href={`/news/${story.id}`}
              eyebrow={formatDate(story.data.date, story.data.datePrecision)}
              title={story.data.title}
              summary={story.data.summary}
              image={story.data.image}
              imageAlt={story.data.imageAlt}
              category={story.data.category}
              footLabel="Read story"
            />
          ))
        }
      </div>
    </div>
  </section>

</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(30rem, 68vh, 42rem);
    align-content: end;
    overflow: hidden;
    background: var(--ink-deep);
    color: #fff;
  }

  .hero__image,
  .hero__wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    object-fit: cover;
    object-position: 56% center;
    filter: saturate(0.6) contrast(1.05);
  }

  .hero__wash { background: var(--hero-wash); }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: clamp(4rem, 10vw, 7rem) clamp(2.5rem, 5vw, 4rem);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.4rem;
    color: var(--sky);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero__eyebrow::before {
    width: 2rem;
    height: 1px;
    flex: none;
    background: currentColor;
    content: '';
  }

  .hero__title {
    max-width: 16ch;
    color: #fff;
    font-size: clamp(2.4rem, 5.2vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.03;
  }

  .hero__subtext {
    max-width: 54ch;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.7;
  }

  .hero__actions { margin-top: var(--space-lg); }

  /* --------------------------------------------------------------- Premise */

  .premise {
    display: grid;
    gap: var(--space-block);
  }

  .premise__copy > * + * { margin-top: 1.1rem; }
  .premise__action { margin-top: 1.4rem; }

  .premise__interests-label { margin-bottom: 0.5rem; }

  .premise__list { display: grid; }

  .premise__list li {
    border-bottom: 1px solid var(--line);
    padding-block: 0.7rem;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .premise { grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr); }
  }
</style>
