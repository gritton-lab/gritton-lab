---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const rendered = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: (await render(project)).Content,
  })),
);

const intro =
  'Our lab uses animal models to understand how neuromodulators contribute to sensory and memory encoding, and how this facilitates interactions across regions of the brain. We use optogenetic and chemogenetic tools to measure how perturbations of neurotransmitter systems associated with illness or disease alter sensory encoding and the coupling of neurons and brain regions, and how that ultimately influences learning, memory, and cognitive and social behavior in mice.';
---

<Base title="Research Projects" description={intro.slice(0, 155)}>
  <PageHeader title="Research Projects" intro={intro} />

  <div class="container-page py-16">
    <!-- Jump list: five long sections benefit from a table of contents. -->
    <nav aria-label="Projects on this page" class="mb-16">
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project, i) => (
            <li>
              <a
                href={`#${project.id}`}
                class="flex h-full items-start gap-3 rounded-lg border border-line bg-surface p-5 text-sm font-medium text-illini-blue transition-colors hover:border-illini-orange hover:text-illini-orange-dark"
              >
                <span
                  aria-hidden="true"
                  class="tabular-nums font-semibold text-illini-orange"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                {project.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="space-y-20">
      {
        rendered.map(({ project, Content }, i) => (
          <section id={project.id} class="scroll-mt-28">
            <div class="flex items-baseline gap-3">
              <span
                aria-hidden="true"
                class="text-sm font-semibold tabular-nums text-illini-orange"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="text-2xl">{project.data.title}</h2>
            </div>

            <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-start">
              <div class="prose-lab order-2 lg:order-1">
                <Content />
              </div>

              {project.data.image && (
                <figure class="order-1 lg:order-2 lg:sticky lg:top-28">
                  <img
                    src={project.data.image}
                    alt={project.data.imageAlt}
                    loading="lazy"
                    class="w-full rounded-lg border border-line bg-surface-sunken"
                  />
                  {project.data.imageAlt && (
                    <figcaption class="mt-2 text-xs text-ink-muted">
                      {project.data.imageAlt}
                    </figcaption>
                  )}
                </figure>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
