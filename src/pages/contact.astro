---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import contact from '../data/contact.json';
---

<Base title="Contact" description={contact.intro}>
  <PageHeader title={contact.heading} intro={contact.intro} />

  <div class="container-page py-16">
    <div class="grid gap-10 lg:grid-cols-[22rem_1fr] lg:items-start">
      <div class="rounded-lg border border-line bg-surface p-8">
        <h2 class="text-lg">{contact.labName}</h2>

        <address class="mt-4 space-y-0.5 text-sm not-italic leading-relaxed text-ink-muted">
          {contact.addressLines.map((line) => <div>{line}</div>)}
        </address>

        <dl class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-illini-blue">
              Email
            </dt>
            <dd class="mt-1">
              <a
                href={`mailto:${contact.email}`}
                class="text-illini-blue underline decoration-illini-orange decoration-2 underline-offset-4 hover:text-illini-orange-dark"
              >
                {contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-illini-blue">
              Phone
            </dt>
            <dd class="mt-1">
              <a
                href={`tel:${contact.phone}`}
                class="text-ink-muted hover:text-illini-blue"
              >
                {contact.phone}
              </a>
            </dd>
          </div>
        </dl>

        <a
          href="/lab-positions"
          class="mt-8 inline-block rounded-md bg-illini-blue px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-illini-blue-light"
        >
          Interested in joining?
        </a>
      </div>

      {
        contact.mapEmbedUrl && (
          <div class="overflow-hidden rounded-lg border border-line">
            <iframe
              src={contact.mapEmbedUrl}
              title={`Map to ${contact.labName}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="h-[30rem] w-full border-0"
            />
          </div>
        )
      }
    </div>
  </div>
</Base>
