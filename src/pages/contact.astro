---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import contact from '../data/contact.json';
import settings from '../data/settings.json';
---

<Base title="Contact" description={contact.intro}>
  <section class="page-section contact-section" aria-labelledby="contact-heading">
    <div class="container-page">
      <header class="contact-intro">
        <p class="eyebrow">Get in touch</p>
        <h1 id="contact-heading">{contact.heading}</h1>
        <p class="lede">For collaborations, joining the lab, media requests, or general questions — we'd love to hear from you.</p>
      </header>

      <div class="section-body contact-grid">
        <div class="contact-details">
          <div class="contact-block">
            <p class="meta">Mailing address</p>
            <address>
              <strong>{contact.labName}</strong>
              {contact.addressLines.map((line) => <span>{line}</span>)}
            </address>
          </div>

          <div class="contact-block">
            <p class="meta">Messaging</p>
            <ul class="contact-links">
              <li><a class="link-underline" href={`mailto:${contact.email}`}>{contact.email}</a></li>
              <li><a class="link-underline" href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>{contact.phone}</a></li>
            </ul>
          </div>

          <div class="contact-block">
            <p class="meta">Publication records</p>
            <ul class="contact-links contact-links--inline">
              <li>
                <a class="link-underline" href={settings.social.googleScholar} target="_blank" rel="noopener noreferrer">
                  Google Scholar
                </a>
              </li>
              <li>
                <a class="link-underline" href={settings.social.pubmed} target="_blank" rel="noopener noreferrer">
                  PubMed bibliography
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="contact-form-wrap">
          <ContactForm id="contact-form" />
        </div>

        <section class="contact-location" aria-labelledby="location-heading">
          <div class="contact-location__heading">
            <div>
              <p class="eyebrow">Find us</p>
              <h2 id="location-heading">Veterinary Medicine Basic Sciences Building</h2>
              <p class="note">2001 South Lincoln Avenue · Urbana, Illinois</p>
            </div>
            <a
              class="text-link"
              href="https://www.google.com/maps/dir/?api=1&destination=Veterinary+Medicine+Basic+Sciences+Building%2C+2001+South+Lincoln+Avenue%2C+Urbana%2C+IL+61802"
              target="_blank"
              rel="noopener noreferrer"
            >
              Get directions
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
          <div class="map">
            <iframe
              src={contact.mapEmbedUrl}
              title="Map to the Veterinary Medicine Basic Sciences Building"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-section {
    padding-block: clamp(1.75rem, 3vw, 2.75rem);
  }

  .contact-intro .eyebrow { margin-bottom: 0.65rem; }

  .contact-intro .lede { margin-top: 0.75rem; }

  .contact-grid {
    display: grid;
    grid-template-areas: 'details' 'form' 'location';
    gap: 1.5rem;
    margin-top: 1.5rem;
    align-items: start;
  }

  .contact-details {
    grid-area: details;
    display: grid;
    gap: 1rem;
  }

  .contact-form-wrap { grid-area: form; min-width: 0; }
  .contact-location {
    grid-area: location;
    min-width: 0;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .contact-location__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.25rem;
  }

  .contact-location .eyebrow { margin-bottom: 0.6rem; }
  .contact-location h2 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
  .contact-location .note { margin-top: 0.4rem; }
  .contact-location .text-link { flex: none; }

  .contact-block .meta { margin-bottom: 0.35rem; }

  .contact-block address {
    display: grid;
    gap: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-style: normal;
    line-height: 1.6;
  }

  .contact-block address strong {
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-weight: 600;
  }

  .contact-links {
    display: grid;
    gap: 0.2rem;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .contact-links--inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
  }

  .map {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .map iframe {
    display: block;
    width: 100%;
    height: clamp(17.5rem, 26vw, 21rem);
    border: 0;
  }

  @media (min-width: 760px) {
    .contact-grid {
      grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
      grid-template-areas: 'details form' 'location location';
      column-gap: var(--space-block);
    }
  }
</style>
