<div class="assembly-scene" data-assembly-scene>
  <canvas class="assembly-scene__canvas" tabindex="0" role="img"
    aria-label="Hundreds of neurons firing at random while groups of them slowly fall into and out of synchrony. Click or press Enter to recruit a group."
  >Neurons flickering independently, with groups that periodically synchronize.</canvas>
  <p class="assembly-scene__hint" data-assembly-hint aria-hidden="true"><span>●</span> Click to synchronize</p>
  <button class="assembly-scene__new" type="button" data-assembly-new hidden>
    <kbd>N</kbd> New pattern
  </button>
</div>

<style>
  .assembly-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--panel-bg);
  }
  .assembly-scene__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: pan-y;
    /* fade the tissue out before it reaches the headline */
    -webkit-mask-image: linear-gradient(to right, transparent 36%, #000 54%);
    mask-image: linear-gradient(to right, transparent 36%, #000 54%);
  }
  .assembly-scene__canvas:focus-visible { outline: 1px solid var(--panel-accent); outline-offset: -5px; }
  .assembly-scene__hint,
  .assembly-scene__new {
    position: absolute;
    z-index: 3;
    right: var(--rail);
    bottom: 2.25rem;
    color: var(--panel-muted);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }
  .assembly-scene__hint { pointer-events: none; user-select: none; }
  .assembly-scene__hint span { margin-right: 0.5rem; color: var(--panel-accent); font-size: 0.5rem; vertical-align: 0.1em; }
  .assembly-scene__new {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem 0.45rem 0.5rem;
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    background: rgba(19, 41, 75, 0.55);
    backdrop-filter: blur(4px);
    cursor: pointer;
    animation: assembly-in 0.5s ease-out;
    transition: background 0.2s, border-color 0.2s;
  }
  .assembly-scene__new[hidden] { display: none; }
  .assembly-scene__new:hover { background: var(--panel-hover); border-color: var(--panel-accent); }
  .assembly-scene__new:focus-visible { outline: 1px solid var(--panel-accent); outline-offset: 2px; }
  .assembly-scene__new kbd {
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border: 1px solid var(--panel-line);
    border-radius: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }
  @keyframes assembly-in { from { opacity: 0; transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) { .assembly-scene__new { animation: none; } }
  @media (max-width: 700px) {
    .assembly-scene__canvas {
      -webkit-mask-image: linear-gradient(to bottom, #000 34%, transparent 50%);
      mask-image: linear-gradient(to bottom, #000 34%, transparent 50%);
    }
    .assembly-scene__hint,
    .assembly-scene__new { left: var(--rail); right: auto; bottom: auto; top: 1.25rem; white-space: nowrap; }
  }
</style>

<script>
  import { createAssemblyScene } from '../lib/assemblyScene';
  document.querySelectorAll<HTMLElement>('[data-assembly-scene]').forEach(createAssemblyScene);
</script>
