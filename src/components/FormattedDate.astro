---
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;

// Format in UTC so a date-only frontmatter value (parsed as midnight UTC) never
// renders as the previous day for viewers west of Greenwich.
const label = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString().slice(0, 10)} class={className}>{label}</time>
