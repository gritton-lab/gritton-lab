---
import settings from '../data/settings.json';

const a = settings.announcement;
const show = a.enabled && a.text.trim().length > 0;
---

{
  show && (
    <div class="announcement">
      <div class="container-page announcement__inner">
        <p>{a.text}</p>
        {a.linkUrl && a.linkLabel && (
          <a href={a.linkUrl}>{a.linkLabel}</a>
        )}
      </div>
    </div>
  )
}

<style>
  .announcement {
    background: var(--ink-deep);
    color: #fff;
  }

  .announcement__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.75rem;
    padding-block: 0.65rem;
    text-align: center;
    font-size: 0.88rem;
  }

  .announcement a {
    color: var(--sky);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .announcement a:hover { color: #fff; }
</style>
