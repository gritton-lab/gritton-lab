---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<div class="border-b border-line bg-surface-sunken">
  <div class="container-page py-14 sm:py-16">
    <h1 class="rule-accent text-3xl sm:text-4xl">{title}</h1>
    {
      intro && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">{intro}</p>
      )
    }
  </div>
</div>
