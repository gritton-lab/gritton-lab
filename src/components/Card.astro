---
/**
 * The one card on the site.
 *
 * Projects, people, and news all render through this component so that a row
 * of cards on any page has the same media ratio, the same internal padding,
 * the same title size, and a footer pinned to the bottom edge. Cards in a row
 * are always equal height and their footers always align, whatever the length
 * of the summary.
 *
 * `media` picks how the image is treated:
 *   photo   — cover crop, for photographs
 *   figure  — contained and padded on white, for scientific figures
 *   portrait— taller 4:5 crop anchored to the top, for headshots
 *
 * When `image` is absent a hatched placeholder of the correct ratio is drawn,
 * so a missing photo never changes the height of its row. News is the one
 * collection where that is common rather than occasional, so an optional
 * `category` swaps the placeholder for a colored panel naming the kind of
 * story instead — a row of undocumented news reads as distinct, deliberate
 * cards rather than the same gray block repeated. Colors and icons come from
 * `../lib/newsCategories`, shared with NewsReel's masthead slides so a story
 * looks the same whichever spot on the page shows it without a photo.
 */
import { CATEGORY_ICON, CATEGORY_LABEL, CATEGORY_STYLE, type NewsCategory } from '../lib/newsCategories';

interface Props {
  href: string;
  title: string;
  eyebrow?: string;
  summary?: string;
  image?: string;
  imageAlt?: string;
  media?: 'photo' | 'figure' | 'portrait';
  /** Shown in the placeholder in place of "Gritton Lab" when there's no image. */
  category?: NewsCategory;
  /** Small labels below the summary — methods, programmes, topics. */
  tags?: string[];
  /** Left-hand footer text; the arrow is always drawn on the right. */
  footLabel?: string;
  footNote?: string;
  class?: string;
}

const {
  href,
  title,
  eyebrow,
  summary,
  image,
  imageAlt = '',
  media = 'photo',
  category,
  tags = [],
  footLabel = 'Read more',
  footNote,
  class: className,
} = Astro.props;

const placeholderStyle = category
  ? `--cat-from:${CATEGORY_STYLE[category].from};--cat-to:${CATEGORY_STYLE[category].to}`
  : undefined;
---

<a href={href} class:list={['card', className]}>
  {
    image ? (
      <div
        class:list={[
          'card__media',
          media === 'figure' && 'card__media--figure',
          media === 'portrait' && 'card__media--portrait',
        ]}
      >
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div
        class:list={[
          'card__media',
          'card__media--empty',
          category && 'card__media--tinted',
          media === 'portrait' && 'card__media--portrait',
        ]}
        style={placeholderStyle}
        aria-hidden="true"
      >
        {
          category ? (
            <>
              <svg
                class="card__placeholder-ghost"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="1"
                set:html={CATEGORY_ICON[category]}
              />
              <span class="card__placeholder-tag">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  set:html={CATEGORY_ICON[category]}
                />
                <span>{CATEGORY_LABEL[category]}</span>
              </span>
            </>
          ) : (
            <span>Gritton Lab</span>
          )
        }
      </div>
    )
  }

  <div class="card__body">
    {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
    <h3 class="card__title">{title}</h3>
    {summary && <p class="card__summary">{summary}</p>}

    {
      tags.length > 0 && (
        <ul class="tag-row card__tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="card__foot">
      <span>{footNote ?? footLabel}</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </div>
  </div>
</a>

<style>
  /* Tags sit just above the footer, never pushed apart from the summary. */
  .card__tags { margin-top: 0.25rem; }
</style>
