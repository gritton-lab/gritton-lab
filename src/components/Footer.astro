---
import settings from '../data/settings.json';
import contact from '../data/contact.json';

const year = new Date().getFullYear();
const { social } = settings;

const profiles = [
  { label: 'Google Scholar', url: social.googleScholar },
  { label: 'PubMed', url: social.pubmed },
  { label: 'Twitter', url: social.twitter },
  { label: 'Bluesky', url: social.bluesky },
  { label: 'GitHub', url: social.github },
].filter((p) => p.url);
---

<footer class="mt-24 border-t border-line bg-surface-sunken">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <img
        src="/images/uploads/gritton-logo.png"
        alt="Gritton Lab"
        width="169"
        height="37"
        class="h-9 w-auto"
      />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-muted">
        {settings.tagline}
      </p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-illini-blue">
        Visit
      </h2>
      <address class="mt-3 space-y-0.5 text-sm not-italic leading-relaxed text-ink-muted">
        {contact.addressLines.map((line) => <div>{line}</div>)}
      </address>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-illini-blue">
        Connect
      </h2>
      <ul class="mt-3 space-y-1.5 text-sm text-ink-muted">
        <li>
          <a class="hover:text-illini-orange-dark" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        </li>
        <li>
          <a class="hover:text-illini-orange-dark" href={`tel:${contact.phone}`}>
            {contact.phone}
          </a>
        </li>
        {
          profiles.map((p) => (
            <li>
              <a
                class="hover:text-illini-orange-dark"
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="container-page flex flex-col gap-2 py-5 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Gritton Lab · University of Illinois Urbana-Champaign</p>
      <p>College of Veterinary Medicine · Department of Comparative Biosciences</p>
    </div>
  </div>
</footer>
