<ilw-footer id="site-footer">
  <a slot="cookies-button" href="https://www.vpaa.uillinois.edu/resources/web_privacy">About Cookies</a>
</ilw-footer>

<script>
  // The Toolkit always renders its unit section. This layout uses only the
  // university footer, so hide that empty section and its blue top border.
  await customElements.whenDefined('ilw-footer');
  const footer = document.querySelector<HTMLElement & { updateComplete: Promise<boolean> }>('#site-footer');
  if (footer) {
    await footer.updateComplete;
    if (footer.shadowRoot) {
      const style = document.createElement('style');
      style.textContent = '.site.section-container { display: none; }';
      footer.shadowRoot.append(style);
    }
  }
</script>

<style>
  ilw-footer {
    display: block;
    flex: none;
  }
</style>
