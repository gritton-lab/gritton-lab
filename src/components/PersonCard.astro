---
import type { CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'team'>;
  Content?: any;
  // The PI gets a wider, two-column treatment.
  featured?: boolean;
}

const { person, Content, featured = false } = Astro.props;
const d = person.data;
const hasBody = Boolean(Content);
---

<article
  class:list={[
    'overflow-hidden rounded-lg border border-line bg-surface',
    featured ? 'grid gap-8 p-8 sm:grid-cols-[14rem_1fr] sm:p-10' : 'flex flex-col',
  ]}
>
  {
    d.photo &&
      (featured ? (
        <img
          src={d.photo}
          alt={d.name}
          class="w-full rounded-lg border border-line object-cover"
        />
      ) : (
        <div class="aspect-[4/5] overflow-hidden bg-surface-sunken">
          <img
            src={d.photo}
            alt={d.name}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      ))
  }

  <div class:list={[featured ? '' : 'flex flex-1 flex-col p-6']}>
    <h3 class:list={[featured ? 'text-2xl' : 'text-lg']}>{d.name}</h3>
    <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-illini-orange-dark">
      {d.role}
    </p>
    {d.program && <p class="mt-2 text-sm text-ink-muted">{d.program}</p>}

    {
      d.education.length > 0 && (
        <ul class="mt-3 space-y-0.5 text-sm text-ink-muted">
          {d.education.map((line: string) => (
            <li>{line}</li>
          ))}
        </ul>
      )
    }

    <dl class="mt-4 space-y-1 text-sm">
      {
        d.email && (
          <div class="flex gap-2">
            <dt class="sr-only">Email</dt>
            <dd>
              <a
                href={`mailto:${d.email}`}
                class="text-illini-blue underline decoration-illini-orange decoration-2 underline-offset-4 hover:text-illini-orange-dark"
              >
                {d.email}
              </a>
            </dd>
          </div>
        )
      }
      {
        d.phone && (
          <div class="flex gap-2">
            <dt class="sr-only">Phone</dt>
            <dd>
              <a href={`tel:${d.phone}`} class="text-ink-muted hover:text-illini-blue">
                {d.phone}
              </a>
            </dd>
          </div>
        )
      }
      {
        (d.lab || d.office) && (
          <div class="flex flex-wrap gap-x-4 text-ink-muted">
            {d.lab && <dd>Lab: {d.lab}</dd>}
            {d.office && <dd>Office: {d.office}</dd>}
          </div>
        )
      }
    </dl>

    {
      hasBody && (
        <div
          class:list={[
            'prose-lab mt-4 text-sm',
            featured ? '' : 'flex-1',
          ]}
        >
          <Content />
        </div>
      )
    }

    {
      d.links.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {d.links.map((link: { label: string; url: string }) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block rounded border border-line px-3 py-1.5 text-xs font-semibold text-illini-blue transition-colors hover:border-illini-orange hover:text-illini-orange-dark"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
