---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'light' | 'dark';
  actionHref?: string;
  actionLabel?: string;
  /** `link` is the default mono underline; `button` draws an outlined button. */
  actionVariant?: 'link' | 'button';
  /** Headings inside a page that already has an h1 stay at h2. */
  as?: 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  tone = 'light',
  actionHref,
  actionLabel,
  actionVariant = 'link',
  as: Tag = 'h2',
  class: className,
} = Astro.props;

const dark = tone === 'dark';
const hasAction = Boolean(actionHref && actionLabel);
---

<div class:list={['section-heading', dark && 'is-dark', className]}>
  {eyebrow && <p class:list={['eyebrow', dark && 'eyebrow--light']}>{eyebrow}</p>}

  <div class="section-heading__row">
    <Tag class="section-heading__title">{title}</Tag>

    {
      hasAction && (
        <a
          href={actionHref}
          class:list={[
            'section-heading__action',
            actionVariant === 'button' ? 'button' : 'text-link',
            actionVariant === 'button' && dark && 'button--light',
          ]}
        >
          {actionLabel}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      )
    }
  </div>

  {intro && <p class="section-heading__intro">{intro}</p>}
</div>

<style>
  .section-heading { position: relative; }

  .section-heading .eyebrow { margin-bottom: 0.75rem; }

  .section-heading__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.9rem var(--space-lg);
  }

  .section-heading__title {
    max-width: 24ch;
    margin: 0;
    text-wrap: balance;
  }

  .section-heading.is-dark .section-heading__title { color: #fff; }

  .section-heading__action { flex: none; }

  .section-heading__intro {
    max-width: 60ch;
    margin-top: 0.9rem;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
  }

  .section-heading.is-dark .section-heading__intro { color: rgba(255, 255, 255, 0.68); }

</style>
