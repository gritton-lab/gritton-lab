---
/* A measured cortical neuron replaying voltages computed with a fitted biophysical model. */
---

<section class="neuron-band" aria-labelledby="neuron-band-title">
  <div class="neuron-band__copy">
    <p class="neuron-band__eyebrow"><span></span> Model</p>
    <h2 id="neuron-band-title">One neuron, <em>branch by branch.</em></h2>
    <p class="neuron-band__lede">
      A real mouse pyramidal cell, traced from the microscope and simulated compartment by compartment.
      Each branch brightens as its own membrane voltage rises, so you can watch inputs arrive in the
      dendrites and each action potential spread out from the cell body.
    </p>

    <div class="neuron-band__legend" aria-hidden="true">
      <span>Rest</span><i></i><span>Depolarized</span>
    </div>

    <dl class="neuron-band__facts">
      <div><dt>Cell</dt><dd>Layer-5 pyramidal, mouse cortex</dd></div>
      <div><dt>Compartments</dt><dd>226 simulated segments</dd></div>
      <div><dt>Model</dt><dd>All-active fit, NEURON</dd></div>
    </dl>

    <p class="neuron-band__note">
      Morphology and fitted channel model from the{' '}
      <a href="https://celltypes.brain-map.org/experiment/electrophysiology/485574832" target="_blank" rel="noopener noreferrer">Allen Cell Types Database</a>{' '}
      (specimen 485574832, visual cortex). An illustrative surrogate, not a recording from our lab
      or an auditory-cortex cell; voltages are precomputed and replayed.
    </p>
  </div>

  <div class="neuron-band__figure" data-reconstructed-neuron>
    <canvas tabindex="0" role="img"
      aria-label="A three-dimensional reconstructed pyramidal neuron whose branches brighten as their simulated voltage rises. Drag or use the arrow keys to rotate; Space pauses."
    ></canvas>
    <p class="neuron-band__status" aria-hidden="true">Loading reconstruction…</p>
    <div class="neuron-band__controls">
      <span class="neuron-band__hint" aria-hidden="true">Drag to rotate</span>
      <button type="button" class="neuron-band__toggle" data-neuron-toggle aria-pressed="false">Pause</button>
    </div>
  </div>
</section>

<script>
  import { createReconstructedNeuron } from '../lib/reconstructedNeuron';
  document.querySelectorAll<HTMLElement>('[data-reconstructed-neuron]').forEach(createReconstructedNeuron);
</script>

<style>
  .neuron-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    width: min(var(--measure), calc(100% - var(--rail) * 2));
    margin-inline: auto;
    padding: clamp(2rem, 4.5vw, 4rem);
    overflow: hidden;
    color: #fff;
    background: radial-gradient(ellipse at 72% 50%, #1c3a63 0%, var(--panel-bg) 62%);
    border-top: 1px solid var(--panel-line);
  }

  .neuron-band__eyebrow { display: flex; align-items: center; gap: 0.7rem; color: var(--panel-muted); font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .neuron-band__eyebrow span { width: 5px; height: 5px; border-radius: 50%; background: var(--panel-accent); box-shadow: 0 0 10px var(--panel-line); }

  .neuron-band h2 { margin-top: 1.75rem; color: var(--panel-text); font-size: clamp(1.8rem, 3.3vw, 3.1rem); font-weight: 600; line-height: 1.12; letter-spacing: -0.02em; }
  .neuron-band h2 em { color: var(--art-line); font-style: normal; }

  .neuron-band__lede { max-width: 42ch; margin-top: 1.4rem; color: var(--panel-muted); font-size: 0.95rem; line-height: 1.7; opacity: 0.88; }

  .neuron-band__legend { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.6rem; color: var(--panel-muted); font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; }
  .neuron-band__legend i { width: 6rem; height: 4px; border-radius: 2px; background: linear-gradient(90deg, rgba(132, 175, 207, 0.55), rgb(252, 250, 252)); box-shadow: 0 0 10px rgba(252, 250, 252, 0.25); }

  .neuron-band__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin: 1.8rem 0 0; }
  .neuron-band__facts div { border-top: 1px solid var(--panel-line); padding-top: 0.8rem; }
  .neuron-band__facts dt { color: var(--panel-muted); font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
  .neuron-band__facts dd { margin: 0.45rem 0 0; color: var(--panel-text); font-size: 0.85rem; font-weight: 600; line-height: 1.4; }

  .neuron-band__note { max-width: 52ch; margin-top: 1.5rem; color: var(--panel-muted); font-size: 0.72rem; line-height: 1.6; opacity: 0.62; }
  .neuron-band__note a { color: inherit; text-underline-offset: 0.2em; }
  .neuron-band__note a:hover { opacity: 1; color: #fff; }

  .neuron-band__figure { position: relative; min-width: 0; height: clamp(26rem, 46vw, 38rem); }
  .neuron-band__figure canvas { display: block; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .neuron-band__figure canvas:active { cursor: grabbing; }
  .neuron-band__figure canvas:focus-visible { outline: 1px solid var(--panel-line); outline-offset: -1px; }

  .neuron-band__status { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: var(--panel-muted); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; pointer-events: none; transition: opacity 0.4s; }
  .neuron-band__figure[data-state='ready'] .neuron-band__status { opacity: 0; }
  .neuron-band__figure[data-state='error'] canvas,
  .neuron-band__figure[data-state='error'] .neuron-band__controls { display: none; }

  .neuron-band__controls { position: absolute; right: 0; bottom: 0; display: flex; align-items: center; gap: 0.9rem; color: var(--panel-muted); font-size: 0.65rem; letter-spacing: 0.06em; }
  .neuron-band__hint { opacity: 0.7; }
  .neuron-band__toggle { padding: 0.35rem 0.8rem; border: 1px solid var(--panel-line); border-radius: 999px; background: rgba(19, 41, 75, 0.55); color: var(--panel-text); font: inherit; cursor: pointer; transition: background 0.2s, border-color 0.2s; }
  .neuron-band__toggle:hover { background: var(--panel-hover); border-color: var(--art-line); }
  .neuron-band__toggle:focus-visible { outline: 1px solid var(--panel-accent); outline-offset: 2px; }

  @media (max-width: 860px) {
    .neuron-band { grid-template-columns: 1fr; }
    .neuron-band__figure { height: min(34rem, 120vw); }
    .neuron-band h2 { font-size: clamp(1.8rem, 7vw, 2.6rem); }
  }
  @media (max-width: 520px) {
    .neuron-band__facts { grid-template-columns: 1fr; gap: 0.9rem; }
  }
</style>
