---
/** Photograph band. Scientific figures belong in uncropped cards. */
interface Props {
  image: string;
  alt: string;
  /** Small mono label, e.g. the venue or the occasion. */
  label?: string;
  caption?: string;
  /** `short` for a divider, `tall` for a moment that should carry more weight. */
  height?: 'short' | 'tall';
  /** Nudges the crop when the subject is not centred in the frame. */
  focus?: string;
}

const { image, alt, label, caption, height = 'short', focus = 'center' } = Astro.props;
---

<figure class:list={['figure-band', height === 'tall' && 'figure-band--tall']}>
  <img src={image} alt={alt} loading="lazy" decoding="async" style={`object-position:${focus}`} />
  <div class="figure-band__wash" aria-hidden="true"></div>

  {
    (label || caption) && (
      <figcaption class="figure-band__caption">
        <div class="container-page">
          {label && <p class="figure-band__label">{label}</p>}
          {caption && <p class="figure-band__text">{caption}</p>}
        </div>
      </figcaption>
    )
  }
</figure>

<style>
  .figure-band {
    position: relative;
    display: flex;
    height: clamp(17rem, 30vw, 22rem);
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink-deep);
  }

  .figure-band--tall { height: clamp(19rem, 40vw, 30rem); }

  .figure-band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.72) contrast(1.04);
  }

  .figure-band__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        0deg,
        rgba(14, 17, 26, 0.94) 0%,
        rgba(14, 17, 26, 0.82) 18%,
        rgba(14, 17, 26, 0.45) 45%,
        rgba(14, 17, 26, 0.1) 100%
      );
  }

  .figure-band__caption {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    color: #fff;
  }

  .figure-band__label {
    max-width: 40ch;
    margin-bottom: 0.5rem;
    color: var(--sky);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  @media (min-width: 700px) {
    .figure-band__label {
      font-size: 0.64rem;
      letter-spacing: 0.14em;
    }
  }

  .figure-band__text {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.35;
  }
</style>
