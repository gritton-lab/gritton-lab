---
/**
 * A full-bleed dark block carrying one statement.
 *
 * The second of the two devices that divide a page — the other is FigureBand.
 * Both run edge to edge and both carry content; neither draws a rule or tints
 * a background just to signal "new section".
 *
 * It reuses the same dark surface as the hero and the closing block, so a
 * statement reads as part of the existing design rather than as a new
 * decoration bolted on. Used on text-heavy pages, where there is no photograph
 * to break the run of prose.
 */
interface Props {
  eyebrow?: string;
  statement: string;
  /** Optional supporting figures shown beneath the statement. */
  stats?: { label: string; value: string }[];
}

const { eyebrow, statement, stats = [] } = Astro.props;
---

<section class="statement-band">
  <div class="container-page">
    {eyebrow && <p class="statement-band__eyebrow">{eyebrow}</p>}
    <p class="statement-band__text">{statement}</p>

    {
      stats.length > 0 && (
        <dl class="statement-band__stats">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .statement-band {
    background: var(--ink-deep);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .statement-band__eyebrow {
    margin-bottom: 1.1rem;
    color: var(--sky);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /*
   * Sized between the page h1 and h2 — large enough to land as the moment it
   * is, without competing with the page title.
   */
  .statement-band__text {
    max-width: 30ch;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .statement-band__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-md) var(--space-lg);
    max-width: 52rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .statement-band__stats dt {
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .statement-band__stats dd {
    margin-top: 0.3rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
</style>
